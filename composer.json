{
  "name": "faso-digital-trading/platform",
  "type": "project",
  "description": "FASO DIGITAL TRADING client and licensing platform",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "aws/aws-sdk-php": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "mockery/mockery": "^1.6"
  },
  "scripts": {
    "test": "phpunit"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
