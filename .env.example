APP_NAME="FASO DIGITAL TRADING"
ADMIN_EMAIL=fasodigitaltrading@gmail.com
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC
TRUSTED_PROXIES=

# Local development uses a new, empty SQLite database. Production should use MySQL 8.4 LTS.
DB_CONNECTION=sqlite
DB_DATABASE=database/black-wolf-local.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=blackwolf
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=blackwolf_session

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail account that owns the app password; use an app password, never the Google account password.
MAIL_USERNAME=fasodigitaltrading@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=fasodigitaltrading@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=
MAIL_LIVE_VERIFIED=false

# Legal operator details are required before commercial launch.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_REGISTRATION=
LEGAL_OPERATOR_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_DISCLOSURES_APPROVED=false
TERMS_VERSION=terms-v2
CONTACT_NOTICE_VERSION=contact-v2

# Generate an independent 32+ character HMAC key for MT5 login/server bindings.
# Generate a persistent random secret per environment (32 bytes / 64 hex characters).
LICENSE_BINDING_KEY=

# Select paydunya only after adding the merchant keys and public legal/deployment settings.
PAYMENT_PROVIDER=
PAYMENTS_CURRENCY=XOF
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_CURRENCY=XOF
PAYDUNYA_TIMEOUT_SECONDS=15
# Informational operations check; it does not block the first live invoice.
PAYDUNYA_LIVE_VERIFIED=false
PAYMENTS_MANUAL_LIVE_VERIFIED=false

# New orders use the daily BCEAO reference rate; the fixed rate remains only for legacy records.
FX_QUOTE_VALID_MINUTES=5
# Retained for a possible future provider; not used by current checkout.
CURRENCYAPI_API_KEY=
CURRENCYAPI_ENDPOINT=https://api.currencyapi.com/v3/rate
FX_RATE_REFRESH_SECONDS=60
FX_RATE_MAX_AGE_SECONDS=180

# Official BCEAO USD/XOF reference source used for live quotes.
FX_BCEAO_REFERENCE_URL=https://www.bceao.int/fr/cours/cours-de-reference-des-principales-devises-contre-Franc-CFA
FX_RATE_REFRESH_MINUTES=360
FX_RATE_MAX_AGE_DAYS=7

# Keep external Coris order status updates disabled until an authorized channel is agreed.
CORIS_MANUAL_CHANNEL_ENABLED=false

# MT5 sync stays disabled until a provider account and restricted reader token are configured.
MT5_CONNECTOR=
METAAPI_REST_BASE_URL=
METAAPI_TIMEOUT_SECONDS=15
METAAPI_HISTORY_DAYS=30

# Backup encryption recipient. Store the private recovery identity outside the application host.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=
